0,"parameters":["\\n<诸葛亮>怎敢戏都督！愿纳军令状：三日不办，甘当重罚。"]},{"code":101,"indent":0,"parameters":["",0,0,1]},{"code":401,"indent":0,"parameters":["周瑜大喜，唤军政司当面取了文书，写下军令状。"]},{"code":101,"indent":0,"parameters":["zhouyu",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<周瑜>待军事毕后，自有酬劳。"]},{"code":101,"indent":0,"parameters":["zhugeliang",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<诸葛亮>今日已不及，来日造起。至第三日，可差五百小军到"]},{"code":401,"indent":0,"parameters":["江边搬箭。"]},{"code":221,"indent":0,"parameters":[]},{"code":223,"indent":0,"parameters":[[-68,-68,-68,0],60,true]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["三日后夜里。"]},{"code":222,"indent":0,"parameters":[]},{"code":223,"indent":0,"parameters":[[-68,-68,0,68],60,true]},{"code":101,"indent":0,"parameters":["zhugeliang",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<诸葛亮>特请子敬同往取箭。"]},{"code":101,"indent":0,"parameters":["lushu",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<鲁肃>何处去取？"]},{"code":101,"indent":0,"parameters":["zhugeliang",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<诸葛亮>子敬休问，前去便见。(鲁肃作为NPC，就不入队了)"]},{"code":121,"indent":0,"parameters":[446,446,0]},{"code":123,"indent":0,"parameters":["A",0]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true},{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":true,"switch1Id":446,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"zhouyu","direction":2,"pattern":1,"characterIndex":0},"list":[{"code":101,"indent":0,"parameters":["zhouyu",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<周瑜>箭呢？"]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true},{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":448,"switch1Valid":true,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"zhouyu","direction":2,"pattern":1,"characterIndex":0},"list":[{"code":101,"indent":0,"parameters":["zhouyu",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<周瑜>先生神算，使人敬服。"]},{"code":101,"indent":0,"parameters":["zhugeliang",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<诸葛亮>诡谲小计，何足为奇。"]},{"code":101,"indent":0,"parameters":["zhouyu",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<周瑜>昨吾主遣使来催督进军，瑜未有奇计，愿先生教我。"]},{"code":101,"indent":0,"parameters":["zhugeliang",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<诸葛亮>亮乃碌碌庸才，安有妙计？"]},{"code":101,"indent":0,"parameters":["zhouyu",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<周瑜>某昨观曹操水寨，极是严整有法，非等闲可攻。思得一计，"]},{"code":401,"indent":0,"parameters":["不知可否。先生幸为我一决之。"]},{"code":101,"indent":0,"parameters":["zhugeliang",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<诸葛亮>都督且休言。各自写于手内，看同也不同。"]},{"code":101,"indent":0,"parameters":["",0,0,1]},{"code":401,"indent":0,"parameters":["两个移近坐榻，各出掌中之字，互相观看，皆大笑。原来周瑜掌中"]},{"code":401,"indent":0,"parameters":["字，乃一“火”字；孔明掌中，亦一“火”字。"]},{"code":101,"indent":0,"parameters":["zhouyu",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<周瑜>既我两人所见相同，更无疑矣。幸勿漏泄。"]},{"code":101,"indent":0,"parameters":["zhugeliang",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<诸葛亮>两家公事，岂有漏泄之理。吾料曹操虽两番经我这条计，"]},{"code":401,"indent":0,"parameters":["然必不为备。今都督尽行之可也。"]},{"code":101,"indent":0,"parameters":["zhouyu",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<周瑜>既用火攻，军中一些硝石和老树枝，我派士兵去寻找，可"]},{"code":401,"indent":0,"pa